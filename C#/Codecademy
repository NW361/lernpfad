##### Operator Shortcut #####

using System;

namespace MakingProgress
{
  class Program
  {
    static void Main(string[] args)
    {
      // Collectively, +=, -=, *=, and /= are known as compound assignment operators.

      // Declare steps variable
      int steps = 0;
      
      // Two steps forward 
      steps += 2;

      // One step back 
      steps--;

      // Print result to the console
      Console.WriteLine( steps );
    }
  }
}


