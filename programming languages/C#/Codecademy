  }
}


##### Money Maker #####

using System;

namespace MoneyMaker
{
  class MainClass
  {
    public static void Main(string[] args)
    {
      Console.WriteLine("Welcome to Money Maker!");
      Console.WriteLine("Enter an amount to convert to coins:");
      
      // 1. Input erfassen
      string input = Console.ReadLine();
      
      // 2. String in Zahl umwandeln
      double totalAmount = Convert.ToDouble(input);
      
      // 3. Ausgabe vor der Berechnung
      Console.WriteLine(totalAmount + " cents is equal to...");
      
      // 4. Münzwerte definieren
      double goldValue = 10;
      double silverValue = 5;
      
      // 5. Goldmünzen berechnen
      double goldCoins = Math.Floor(totalAmount / goldValue);
      
      // 6. Rest nach Goldmünzen berechnen
      double remainder = totalAmount % goldValue;
      
      // 7. Silbermünzen berechnen
      double silverCoins = Math.Floor(remainder / silverValue);
      
      // 8. Rest nach Silbermünzen berechnen
      remainder = remainder % silverValue;
      
      // 9. Alle Münzen ausgeben
      Console.WriteLine("Gold coins: " + goldCoins);
      Console.WriteLine("Silver coins: " + silverCoins);
      Console.WriteLine("Bronze coins: " + remainder);
    }
  }
}


